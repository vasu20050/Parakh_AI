# Database Configuration
DATABASE_URL=postgresql+asyncpg://trustgraph:trustgraph@localhost:5432/trustgraph
POSTGRES_USER=trustgraph
POSTGRES_PASSWORD=trustgraph
POSTGRES_DB=trustgraph

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Security
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# External API Keys (Optional / Degrades Gracefully)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key_here
GOOGLE_SEARCH_CX=your_custom_search_cx_id_here
SERPAPI_API_KEY=your_serpapi_key_here

# File Storage & Validation
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100

# CORS & Server
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
